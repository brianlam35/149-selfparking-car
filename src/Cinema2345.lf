/**
 * PARKING GARAGE - SPOTS 2-5
 * ==========================
 * 
 * Layout:
 *   Entry -> Left turn into corridor -> Spots 2-5
 *   Spots 2,4 on LEFT side (turn left)
 *   Spots 3,5 on RIGHT side (turn right)
 * 
 * Turn logic:
 *   - Trigger: sensor 0 or 4 rising edge
 *   - During turn: stop one wheel, spin other
 *   - Complete: trigger sensor sees WHITE + front sensors see line
 */

target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Display from "lib/Display.lf"
import MotorsWithFeedback from "lib/MotorsWithFeedback.lf"
import Encoders from "lib/Encoders.lf"
import Line from "lib/Line.lf"

preamble {=
  #include <pico/stdlib.h>
=}

reactor ParkingController {
  input reflect: uint16_t[5]
  input target_spot: int
  
  output calibrate: bool
  output lp: float
  output rp: float
  output notify: string
  output state_display: string

  // Tunables
  state threshold: int = 220
  state forward_speed: float = 0.08
  state turn_speed: float = 0.08
  
  // State tracking
  state parking_spot: int = 0
  state spot_count: int = 0          // Counts spots passed in corridor
  state last_left_high: bool = false
  state last_right_high: bool = false
  
  timer end_calibration(5 s)

  reaction(startup) -> calibrate, lp, rp, notify, state_display {=
    lf_set(calibrate, true);
    lf_set(lp, 0.0f);
    lf_set(rp, 0.0f);
    lf_set(notify, "CALIBRATING");
    lf_set(state_display, "CALIB");
    printf("=== PARKING GARAGE ===\n");
  =}

  reaction(end_calibration) -> calibrate, notify, state_display {=
    lf_set(calibrate, false);
    lf_set(notify, "READY");
    lf_set(state_display, "WAIT");
    printf("Ready - waiting for target\n");
  =}

  // ============================================================
  // MODE: WAITING - Wait for target spot
  // ============================================================
  initial mode WAITING {
    reaction(target_spot) -> reset(FOLLOW_TO_CORRIDOR), lp, rp, notify, state_display {=
      self->parking_spot = target_spot->value;
      self->spot_count = 0;
      self->last_left_high = false;
      self->last_right_high = false;
      
      printf("Target: Spot %d\n", self->parking_spot);
      
      char msg[20];
      snprintf(msg, sizeof(msg), "GO->%d", self->parking_spot);
      lf_set(notify, msg);
      lf_set(state_display, "FOLLOW1");
      lf_set_mode(FOLLOW_TO_CORRIDOR);
    =}
  }
  

  // ============================================================
  // MODE: FOLLOW_TO_CORRIDOR - Follow line until left sensor triggers
  // Then turn left into corridor
  // Uses sensors 1,2,3 for line following, sensor 0 for turn trigger
  // ============================================================
  mode FOLLOW_TO_CORRIDOR {
    reaction(reflect) -> lp, rp, notify, state_display, reset(TURN_INTO_CORRIDOR) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      
      // Line following using center 3 sensors
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      
      // Simple line following: adjust based on which sensors see the line
      float left_power = self->forward_speed;
      float right_power = self->forward_speed;
      
      if (cl_high && !cr_high) {
        // Line is to the left, turn left
        left_power = self->forward_speed * 0.5f;
        right_power = self->forward_speed;
      } else if (cr_high && !cl_high) {
        // Line is to the right, turn right
        left_power = self->forward_speed;
        right_power = self->forward_speed * 0.5f;
      }
      // If center or both sides see line, go straight
      
      lf_set(lp, left_power);
      lf_set(rp, right_power);
      
      // Left sensor rising edge -> turn into corridor
      if (left_rising) {
        printf("Left sensor triggered -> TURN_INTO_CORRIDOR\n");
        lf_set(notify, "TURN->CORR");
        lf_set(state_display, "TURN_L");
        lf_set_mode(TURN_INTO_CORRIDOR);
      }
      
      self->last_left_high = left_high;
    =}
  }

  // ============================================================
  // MODE: TURN_INTO_CORRIDOR - Turn left until sensor 0 sees white
  // and front sensors see line
  // ============================================================
  mode TURN_INTO_CORRIDOR {
    reaction(reflect) -> lp, rp, notify, state_display, reset(FOLLOW_IN_CORRIDOR) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      bool all_front_on_line = (cl_high && c_high && cr_high);
      
      // Turn left: stop left wheel, right wheel forward
      lf_set(lp, 0.0f);
      lf_set(rp, self->turn_speed);
      
      // Turn complete: sensor 0 sees white AND front sensors see line
      if (!left_high && all_front_on_line) {
        printf("Turn complete -> FOLLOW_IN_CORRIDOR\n");
        
        self->last_left_high = false;
        self->last_right_high = false;
        
        lf_set(notify, "IN CORR");
        lf_set_mode(FOLLOW_IN_CORRIDOR);
        lf_set(state_display, "FOLLOW2");
      }
    =}
  }

  // ============================================================
  // MODE: FOLLOW_IN_CORRIDOR - Follow line, count spots on left/right
  // Turn into spot when we reach target
  // 
  // Uses sensors 1,2,3 for line following
  // Uses sensors 0,4 for spot detection
  //
  // Counter logic:
  //   - Spots come in pairs: 2&3 (first pair), 4&5 (second pair)
  //   - Left sensor (0) detects spots 2, 4 (even, left side)
  //   - Right sensor (4) detects spots 3, 5 (odd, right side)
  //   - Count increments on EITHER sensor rising edge
  //   - Turn left for even spots (2,4), right for odd spots (3,5)
  // ============================================================
  mode FOLLOW_IN_CORRIDOR {
    reaction(reflect) -> lp, rp, notify, state_display, reset(TURN_LEFT_INTO_SPOT), reset(TURN_RIGHT_INTO_SPOT) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];
      
      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);
      
      // Line following using center 3 sensors
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      
      // Simple line following: adjust based on which sensors see the line
      float left_power = self->forward_speed;
      float right_power = self->forward_speed;
      
      if (cl_high && !cr_high) {
        // Line is to the left, turn left
        left_power = self->forward_speed * 0.5f;
        right_power = self->forward_speed;
      } else if (cr_high && !cl_high) {
        // Line is to the right, turn right
        left_power = self->forward_speed;
        right_power = self->forward_speed * 0.5f;
      }
      // If center or both sides see line, go straight
      
      lf_set(lp, left_power);
      lf_set(rp, right_power);
      
      // Determine target count based on parking spot
      // Spots 2,3 -> need count 1
      // Spots 4,5 -> need count 2
      int target_count;
      if (self->parking_spot == 2 || self->parking_spot == 3) {
        target_count = 1;
      } else {
        target_count = 2;
      }
      
      // Check if we should turn NOW (before incrementing count)
      // Even spots (2,4): turn LEFT when LEFT sensor triggers
      // Odd spots (3,5): turn RIGHT when RIGHT sensor triggers
      bool is_even_spot = (self->parking_spot % 2 == 0);
      
      if (is_even_spot && left_rising) {
        // Even spot (2 or 4): left sensor triggered
        self->spot_count++;
        
        char msg[20];
        snprintf(msg, sizeof(msg), "L:%d T:%d", self->spot_count, self->parking_spot);
        lf_set(notify, msg);
        printf("Left sensor: count=%d, target=%d\n", self->spot_count, self->parking_spot);
        
        if (self->spot_count == target_count) {
          printf("Turning LEFT into spot %d\n", self->parking_spot);
          lf_set(state_display, "TURN_L");
          lf_set_mode(TURN_LEFT_INTO_SPOT);
        }
      } 
      else if (!is_even_spot && right_rising) {
        // Odd spot (3 or 5): right sensor triggered
        self->spot_count++;
        
        char msg[20];
        snprintf(msg, sizeof(msg), "R:%d T:%d", self->spot_count, self->parking_spot);
        lf_set(notify, msg);
        printf("Right sensor: count=%d, target=%d\n", self->spot_count, self->parking_spot);
        
        if (self->spot_count == target_count) {
          printf("Turning RIGHT into spot %d\n", self->parking_spot);
          lf_set(state_display, "TURN_R");
          lf_set_mode(TURN_RIGHT_INTO_SPOT);
        }
      }
      else if (left_rising || right_rising) {
        // Other sensor triggered (not our target side) - still count for display
        // but don't turn
        char msg[20];
        snprintf(msg, sizeof(msg), "CNT:%d T:%d", self->spot_count, self->parking_spot);
        lf_set(notify, msg);
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high;
    =}
  }

  // ============================================================
  // MODE: TURN_LEFT_INTO_SPOT - Turn left into parking spot
  // ============================================================
  mode TURN_LEFT_INTO_SPOT {
    reaction(reflect) -> lp, rp, notify, state_display, reset(PARK_FORWARD) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      bool all_front_on_line = (cl_high && c_high && cr_high);
      
      // Turn left: stop left wheel, right wheel forward
      lf_set(lp, 0.0f);
      lf_set(rp, self->turn_speed);
      
      // Turn complete: sensor 0 sees white AND front sensors see line
      if (!left_high && all_front_on_line) {
        printf("Turn into spot complete -> PARK_FORWARD\n");
        
        self->last_left_high = false;
        self->last_right_high = false;
        
        lf_set(notify, "PARKING");
        lf_set(state_display, "PARK");
        lf_set_mode(PARK_FORWARD);
      }
    =}
  }

  // ============================================================
  // MODE: TURN_RIGHT_INTO_SPOT - Turn right into parking spot
  // ============================================================
  mode TURN_RIGHT_INTO_SPOT {
    reaction(reflect) -> lp, rp, notify, state_display, reset(PARK_FORWARD) {=
      int R4 = reflect->value[4];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool right_high = (R4 > self->threshold);
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      bool all_front_on_line = (cl_high && c_high && cr_high);
      
      // Turn right: left wheel forward, stop right wheel
      lf_set(lp, self->turn_speed);
      lf_set(rp, 0.0f);
      
      // Turn complete: sensor 4 sees white AND front sensors see line
      if (!right_high && all_front_on_line) {
        printf("Turn into spot complete -> PARK_FORWARD\n");
        
        self->last_left_high = false;
        self->last_right_high = false;
        
        lf_set(notify, "PARKING");
        lf_set(state_display, "PARK");
        lf_set_mode(PARK_FORWARD);
      }
    =}
  }

  // ============================================================
  // MODE: PARK_FORWARD - Follow line until it ends (all white)
  // Uses sensors 1,2,3 for line following
  // ============================================================
  mode PARK_FORWARD {
    reaction(reflect) -> lp, rp, notify, state_display, reset(PARKED) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];
      
      bool all_white = (L0 < self->threshold && CL < self->threshold && 
                       C < self->threshold && CR < self->threshold && R4 < self->threshold);
      
      // Line following using center 3 sensors
      bool cl_high = (CL > self->threshold);
      bool c_high  = (C  > self->threshold);
      bool cr_high = (CR > self->threshold);
      
      // Simple line following: adjust based on which sensors see the line
      float left_power = self->forward_speed;
      float right_power = self->forward_speed;
      
      if (cl_high && !cr_high) {
        // Line is to the left, turn left
        left_power = self->forward_speed * 0.5f;
        right_power = self->forward_speed;
      } else if (cr_high && !cl_high) {
        // Line is to the right, turn right
        left_power = self->forward_speed;
        right_power = self->forward_speed * 0.5f;
      }
      // If center or both sides see line, go straight
      
      lf_set(lp, left_power);
      lf_set(rp, right_power);
      
      // Stop when line ends
      if (all_white) {
        printf("=== PARKED IN SPOT %d ===\n", self->parking_spot);
        
        lf_set(lp, 0.0f);
        lf_set(rp, 0.0f);
        
        char msg[20];
        snprintf(msg, sizeof(msg), "PARKED %d", self->parking_spot);
        lf_set(notify, msg);
        lf_set(state_display, "DONE");
        lf_set_mode(PARKED);
      }
    =}
  }

  // ============================================================
  // MODE: PARKED - Done
  // ============================================================
  mode PARKED {
    reaction(target_spot) -> notify {=
      // Could handle exit here later
      printf("Already parked. Exit not implemented.\n");
    =}
  }
}

// ============================================================
// MAIN REACTOR
// ============================================================
main reactor {
  timer t(0, 10 ms)
  timer send_target(6 s)

  controller = new ParkingController()
  disp       = new Display()
  motors     = new MotorsWithFeedback()
  encoder    = new Encoders()
  line       = new Line()

  // TEST: Send target spot 3 after calibration
  reaction(send_target) -> controller.target_spot {=
    lf_set(controller.target_spot, 1);  // Change to 2, 3, 4, or 5 to test
  =}

  // Display
  controller.notify -> disp.line0
  controller.state_display -> disp.line1

  // Sensors
  line.reflect -> controller.reflect
  
  // Motors
  controller.lp -> motors.left_speed
  controller.rp -> motors.right_speed

  // Calibration
  controller.calibrate -> line.calibrate

  // Encoders
  encoder.left  -> motors.left
  encoder.right -> motors.right
  
  reaction(t) -> encoder.trigger {=
    lf_set(encoder.trigger, true);
  =}

  reaction(t) -> line.trigger {=
    lf_set(line.trigger, true);
  =}
}
