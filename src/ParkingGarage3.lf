/**
 * PARKING GARAGE NAVIGATION SYSTEM
 * =================================
 * 
 * Layout:
 *   - Enter: Bottom-left
 *   - Exit: Top-right  
 *   - Spot 1: End of entry path (bottom-right)
 *   - Spots 2-5: First vertical corridor (2,4 on left; 3,5 on right)
 *   - Spots 6-9: Second corridor after 2 left turns (6,8 on right; 7,9 on left)
 * 
 * Counter Logic:
 *   - Starts at -1
 *   - +1 when only one sensor fires (single line)
 *   - +2 when both L and R sensors fire (spots on both sides)
 * 
 * Turn Directions:
 *   - Spots 2-5: Even (2,4) = LEFT, Odd (3,5) = RIGHT
 *   - Spots 6-9: Even (6,8) = RIGHT, Odd (7,9) = LEFT (reversed after 2 lefts)
 */

target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Display from "lib/Display.lf"
import MotorsWithFeedback from "lib/MotorsWithFeedback.lf"
import Encoders from "lib/Encoders.lf"
import Line from "lib/Line.lf"

preamble {=
  #include <math.h>
  #include <stdlib.h>
  #include <pico/stdlib.h>
=}

// ============================================================
// LINE FOLLOWER WITH PID CONTROL
// ============================================================
reactor LineFollower {
  input reflect: uint16_t[5]
  input enable: bool
  
  output lp: float
  output rp: float
  
  // PID parameters - tunable
  state kp: float = 0.15
  state ki: float = 0.0
  state kd: float = 0.05
  
  state base_speed: float = 0.10
  state max_speed: float = 0.15
  state threshold: int = 220
  
  state last_error: float = 0.0
  state integral: float = 0.0
  state enabled: bool = false
  
  reaction(enable) {=
    self->enabled = enable->value;
    // Reset PID state when re-enabled
    if (enable->value) {
      self->integral = 0.0f;
      self->last_error = 0.0f;
    }
  =}
  
  reaction(reflect) -> lp, rp {=
    if (!self->enabled) {
      return;
    }
    
    int L0 = reflect->value[0];
    int CL = reflect->value[1];
    int C  = reflect->value[2];
    int CR = reflect->value[3];
    int R4 = reflect->value[4];
    
    float weighted_sum = 0.0f;
    float total_weight = 0.0f;
    
    if (L0 > self->threshold) { weighted_sum += -2.0f * L0; total_weight += L0; }
    if (CL > self->threshold) { weighted_sum += -1.0f * CL; total_weight += CL; }
    if (C  > self->threshold) { weighted_sum +=  0.0f * C;  total_weight += C;  }
    if (CR > self->threshold) { weighted_sum +=  1.0f * CR; total_weight += CR; }
    if (R4 > self->threshold) { weighted_sum +=  2.0f * R4; total_weight += R4; }
    
    if (total_weight < 1.0f) {
      lf_set(lp, 0.0f);
      lf_set(rp, 0.0f);
      return;
    }
    
    float error = weighted_sum / total_weight;
    
    self->integral += error;
    if (self->integral > 10.0f) self->integral = 10.0f;
    if (self->integral < -10.0f) self->integral = -10.0f;
    
    float derivative = error - self->last_error;
    float correction = self->kp * error + self->ki * self->integral + self->kd * derivative;
    self->last_error = error;
    
    float left_speed = self->base_speed + correction;
    float right_speed = self->base_speed - correction;
    
    if (left_speed > self->max_speed) left_speed = self->max_speed;
    if (left_speed < -self->max_speed) left_speed = -self->max_speed;
    if (right_speed > self->max_speed) right_speed = self->max_speed;
    if (right_speed < -self->max_speed) right_speed = -self->max_speed;
    
    lf_set(lp, left_speed);
    lf_set(rp, right_speed);
  =}
}

// ============================================================
// PARKING GARAGE NAVIGATION CONTROLLER
// ============================================================
reactor ParkingController {
  input reflect: uint16_t[5]
  input target_spot: int
  
  output calibrate: bool
  output line_enable: bool
  output lp: float
  output rp: float
  output notify: string
  output state_display: string

  // Tunables
  state threshold: int = 220
  state turn_speed: float = 0.08
  
  // State tracking
  state parking_spot: int = 0
  state counter: int = -1
  state left_trigger_count: int = 0  // Tracks total left sensor triggers
  state last_left_high: bool = false
  state last_right_high: bool = false
  state turn_committed: bool = false
  state turning: bool = false
  state turns_completed: int = 0
  state ignore_right_sensor: bool = false
  
  timer end_calibration(5 s)

  reaction(startup) -> calibrate, line_enable, lp, rp, notify, state_display {=
    lf_set(calibrate, true);
    lf_set(line_enable, false);
    lf_set(lp, 0.0f);
    lf_set(rp, 0.0f);
    lf_set(notify, "LEFT:0");
    lf_set(state_display, "CALIBRATE");
    printf("=== PARKING GARAGE SYSTEM ===\n");
  =}

  reaction(end_calibration) -> calibrate, notify, state_display {=
    lf_set(calibrate, false);
    lf_set(notify, "LEFT:0");
    lf_set(state_display, "READY");
    printf("System ready\n");
  =}

  // ============================================================
  // MODE: WAITING - Idle, waiting for target parking spot
  // ============================================================
  initial mode WAITING {
    reaction(target_spot) -> reset(NAVIGATE_TO_FIRST_TURN), reset(NAVIGATE_SPOT_1), 
                             line_enable, notify, state_display {=
      self->parking_spot = target_spot->value;
      
      // Reset all state
      self->counter = -1;
      self->left_trigger_count = 0;
      self->last_left_high = false;
      self->last_right_high = false;
      self->turn_committed = false;
      self->turning = false;
      self->turns_completed = 0;
      self->ignore_right_sensor = false;
      
      printf("\n>>> TARGET: Spot %d <<<\n", self->parking_spot);
      
      char msg[20];
      snprintf(msg, sizeof(msg), "LEFT:0 ->%d", self->parking_spot);
      lf_set(notify, msg);
      
      if (self->parking_spot == 1) {
        lf_set_mode(NAVIGATE_SPOT_1);
        lf_set(line_enable, true);
        lf_set(state_display, "NAV_SPOT1");
      } else if (self->parking_spot >= 2 && self->parking_spot <= 9) {
        if (self->parking_spot >= 2 && self->parking_spot <= 5) {
          self->ignore_right_sensor = true;
        }
        lf_set_mode(NAVIGATE_TO_FIRST_TURN);
        lf_set(line_enable, true);
        lf_set(state_display, "NAV_1ST");
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_SPOT_1 - Go straight to spot 1
  // ============================================================
  mode NAVIGATE_SPOT_1 {
    reaction(reflect) -> notify, state_display, reset(PARK_FORWARD) {=
      int L0 = reflect->value[0];
      
      bool left_high = (L0 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      
      if (left_rising) {
        self->left_trigger_count++;
        self->counter = 0;
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d", self->left_trigger_count);
        lf_set(notify, msg);
        printf("Left trigger #%d\n", self->left_trigger_count);
      }
      self->last_left_high = left_high;

      if (self->counter >= 0 && !self->turn_committed) {
        self->turn_committed = true;
        lf_set_mode(PARK_FORWARD);
        lf_set(state_display, "PARK_FWD");
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_TO_FIRST_TURN - Get to first intersection
  // ============================================================
  mode NAVIGATE_TO_FIRST_TURN {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_CORRIDOR) {=
      int L0 = reflect->value[0];
      
      bool left_high = (L0 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      
      if (left_rising) {
        self->left_trigger_count++;
        self->counter++;
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d", self->left_trigger_count);
        lf_set(notify, msg);
        printf("Left trigger #%d, Counter: %d\n", self->left_trigger_count, self->counter);
        
        // When counter=0, turn left into corridor
        if (self->counter == 0) {
          self->turning = true;
          lf_set(line_enable, false);
          lf_set_mode(TURN_INTO_CORRIDOR);
          lf_set(state_display, "TURN_CORR");
          printf("Starting left turn into corridor\n");
        }
      }
      self->last_left_high = left_high;
    =}
  }

  // ============================================================
  // MODE: TURN_INTO_CORRIDOR - Complete left turn, ignore ALL sensors for counting
  // Only checks center sensors to know when turn is complete
  // ============================================================
  mode TURN_INTO_CORRIDOR {
    reaction(reflect) -> lp, rp, line_enable, notify, state_display,
                         reset(NAVIGATE_CORRIDOR_2_5), reset(NAVIGATE_CORRIDOR_6_9) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      
      // ALWAYS turn left - no counting, no state changes until complete
      lf_set(lp, -self->turn_speed);
      lf_set(rp, self->turn_speed);
      
      // Turn complete ONLY when:
      // 1. Center sensors see the line (aligned with corridor)
      // 2. Left sensor is OFF (rotated past the intersection)
      if (center_line && !left_high) {
        // NOW reset sensor states for fresh detection in next mode
        self->last_left_high = false;
        self->last_right_high = false;
        self->turning = false;
        self->turn_committed = false;
        
        lf_set(line_enable, true);
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d", self->left_trigger_count);
        lf_set(notify, msg);
        
        if (self->parking_spot >= 6 && self->parking_spot <= 9) {
          self->ignore_right_sensor = false;
          lf_set_mode(NAVIGATE_CORRIDOR_6_9);
          lf_set(state_display, "NAV_6-9");
          printf("Turn complete - corridor for spots 6-9\n");
        } else {
          lf_set_mode(NAVIGATE_CORRIDOR_2_5);
          lf_set(state_display, "NAV_2-5");
          printf("Turn complete - corridor for spots 2-5\n");
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_CORRIDOR_2_5 - Navigate to spots 2-5
  // ============================================================
  mode NAVIGATE_CORRIDOR_2_5 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_SPOT) {=
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high_actual = (R4 > self->threshold);
      bool right_high = self->ignore_right_sensor ? false : right_high_actual;
      
      bool left_rising = (left_high && !self->last_left_high);
      bool left_falling = (!left_high && self->last_left_high);
      bool right_rising = (!self->ignore_right_sensor && right_high && !self->last_right_high);

      // Count on left rising edge only
      if (!self->turning && left_rising) {
        self->left_trigger_count++;
        
        if (self->ignore_right_sensor) {
          self->counter += 1;
        } else if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d C:%d", self->left_trigger_count, self->counter);
        lf_set(notify, msg);
        printf("Left #%d, Counter: %d, Target: %d\n", self->left_trigger_count, self->counter, self->parking_spot);
      }
      
      // Enable right sensor AFTER leaving spot 1 intersection
      if (self->ignore_right_sensor && self->counter >= 1 && left_falling) {
        self->ignore_right_sensor = false;
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d R_ON", self->left_trigger_count);
        lf_set(notify, msg);
        printf("Right sensor ENABLED\n");
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high_actual;

      // Determine turn threshold
      int turn_threshold;
      if (self->parking_spot == 2 || self->parking_spot == 3) {
        turn_threshold = 1;
      } else {
        turn_threshold = 3;
      }
      
      // Turn decision - only if not ignoring right sensor
      if (self->counter >= turn_threshold && !self->turn_committed && !self->ignore_right_sensor) {
        bool should_turn = false;
        
        if (self->parking_spot % 2 == 0) {
          should_turn = left_high;  // Even: turn left
        } else {
          should_turn = right_high;  // Odd: turn right
        }
        
        if (should_turn) {
          self->turn_committed = true;
          self->turning = true;
          lf_set(line_enable, false);
          lf_set_mode(TURN_INTO_SPOT);
          lf_set(state_display, "TURN_IN");
          printf("Turning into spot %d\n", self->parking_spot);
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_CORRIDOR_6_9 - Pass all spots, then make 2 left turns
  // ============================================================
  mode NAVIGATE_CORRIDOR_6_9 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(MAKE_TWO_LEFT_TURNS) {=
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);

      if (!self->turning && (left_rising || right_rising)) {
        if (left_rising) self->left_trigger_count++;
        
        if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d C:%d", self->left_trigger_count, self->counter);
        lf_set(notify, msg);
        printf("Left #%d, Counter: %d\n", self->left_trigger_count, self->counter);
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high;

      if (self->counter >= 5 && !self->turn_committed) {
        self->turn_committed = true;
        self->turns_completed = 0;
        lf_set_mode(MAKE_TWO_LEFT_TURNS);
        lf_set(state_display, "2_TURNS");
        printf("Starting 2 left turns\n");
      }
    =}
  }

  // ============================================================
  // MODE: MAKE_TWO_LEFT_TURNS - Execute 2 left turns for 6-9
  // Ignores all counting during turns
  // ============================================================
  mode MAKE_TWO_LEFT_TURNS {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(NAVIGATE_FINAL_6_9) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];

      bool left_high = (L0 > self->threshold);
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      
      if (self->turns_completed < 2) {
        // Start turn when left sensor first detects line (and not already turning)
        if (left_high && !self->turning) {
          self->turning = true;
          lf_set(line_enable, false);
        }
        
        // During turn - just turn, ignore everything
        if (self->turning) {
          lf_set(lp, -self->turn_speed);
          lf_set(rp, self->turn_speed);
          
          // Turn complete when left sensor OFF and center sees line
          if (!left_high && center_line) {
            self->turns_completed++;
            self->turning = false;
            lf_set(line_enable, true);
            
            char msg[20];
            snprintf(msg, sizeof(msg), "LEFT:%d T%d/2", self->left_trigger_count, self->turns_completed);
            lf_set(notify, msg);
            printf("Turn %d/2 complete\n", self->turns_completed);
            
            if (self->turns_completed >= 2) {
              self->turn_committed = false;
              self->last_left_high = false;
              self->last_right_high = false;
              lf_set_mode(NAVIGATE_FINAL_6_9);
              lf_set(state_display, "NAV_FNL69");
            }
          }
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_FINAL_6_9 - Navigate to spot 6-9
  // ============================================================
  mode NAVIGATE_FINAL_6_9 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_SPOT) {=
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);

      if (!self->turning && (left_rising || right_rising)) {
        if (left_rising) self->left_trigger_count++;
        
        if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d C:%d", self->left_trigger_count, self->counter);
        lf_set(notify, msg);
        printf("Left #%d, Counter: %d, Target: %d\n", self->left_trigger_count, self->counter, self->parking_spot);
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high;

      int turn_threshold = (self->parking_spot <= 7) ? 5 : 7;
      
      if (self->counter >= turn_threshold && !self->turn_committed) {
        bool should_turn = false;
        
        // Reversed: Even (6,8) = RIGHT, Odd (7,9) = LEFT
        if (self->parking_spot % 2 == 0) {
          should_turn = right_high;
        } else {
          should_turn = left_high;
        }
        
        if (should_turn) {
          self->turn_committed = true;
          self->turning = true;
          lf_set(line_enable, false);
          lf_set_mode(TURN_INTO_SPOT);
          lf_set(state_display, "TURN_IN");
          printf("Turning into spot %d\n", self->parking_spot);
        }
      }
    =}
  }

  // ============================================================
  // MODE: TURN_INTO_SPOT - Turn into parking spot, ignore all counting
  // ============================================================
  mode TURN_INTO_SPOT {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(PARK_FORWARD) {=
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);

      // Determine turn direction
      bool turn_right;
      if (self->parking_spot >= 6) {
        turn_right = (self->parking_spot % 2 == 0);  // 6,8 = right
      } else {
        turn_right = (self->parking_spot % 2 == 1);  // 3,5 = right
      }

      // ALWAYS execute turn - no counting, no other state changes
      if (turn_right) {
        lf_set(lp, self->turn_speed);
        lf_set(rp, -self->turn_speed);
      } else {
        lf_set(lp, -self->turn_speed);
        lf_set(rp, self->turn_speed);
      }

      // Turn complete when center sees line AND we've rotated away from main corridor
      bool rotated_away = turn_right ? !right_high : !left_high;
      
      if (center_line && rotated_away) {
        // Reset states for parking
        self->turning = false;
        self->last_left_high = false;
        self->last_right_high = false;
        
        lf_set(line_enable, true);
        lf_set_mode(PARK_FORWARD);
        
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d", self->left_trigger_count);
        lf_set(notify, msg);
        lf_set(state_display, "PARK_FWD");
        printf("Turn complete - parking in spot %d\n", self->parking_spot);
      }
    =}
  }

  // ============================================================
  // MODE: PARK_FORWARD - Follow line until it ends
  // ============================================================
  mode PARK_FORWARD {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(PARKED) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool all_white = (L0 < self->threshold && CL < self->threshold && 
                       C < self->threshold && CR < self->threshold && R4 < self->threshold);

      if (all_white) {
        lf_set(line_enable, false);
        lf_set(lp, 0.0f);
        lf_set(rp, 0.0f);
        lf_set_mode(PARKED);
        char msg[20];
        snprintf(msg, sizeof(msg), "LEFT:%d DONE", self->left_trigger_count);
        lf_set(notify, msg);
        lf_set(state_display, "PARKED");
        printf("=== PARKED IN SPOT %d ===\n", self->parking_spot);
      }
    =}
  }

  // ============================================================
  // MODE: PARKED - Done (exit logic removed for now)
  // ============================================================
  mode PARKED {
    reaction(target_spot) -> notify {=
      // Exit logic removed - placeholder for later
      if (target_spot->value == 0) {
        printf("Exit requested - not implemented yet\n");
        lf_set(notify, "NO EXIT");
      }
    =}
  }
}

// ============================================================
// MOTOR ARBITER
// ============================================================
reactor MotorArbiter {
  input controller_lp: float
  input controller_rp: float
  input line_follower_lp: float
  input line_follower_rp: float
  input use_line_follower: bool
  
  output lp: float
  output rp: float
  
  state use_follower: bool = false
  
  reaction(use_line_follower) {=
    self->use_follower = use_line_follower->value;
  =}
  
  reaction(controller_lp, controller_rp) -> lp, rp {=
    if (!self->use_follower) {
      if (controller_lp->is_present) lf_set(lp, controller_lp->value);
      if (controller_rp->is_present) lf_set(rp, controller_rp->value);
    }
  =}
  
  reaction(line_follower_lp, line_follower_rp) -> lp, rp {=
    if (self->use_follower) {
      if (line_follower_lp->is_present) lf_set(lp, line_follower_lp->value);
      if (line_follower_rp->is_present) lf_set(rp, line_follower_rp->value);
    }
  =}
}

// ============================================================
// MAIN REACTOR
// ============================================================
main reactor {
  timer t(0, 10 ms)
  timer send_target(6 s)

  controller    = new ParkingController()
  line_follower = new LineFollower()
  motor_arbiter = new MotorArbiter()
  disp          = new Display()
  motors        = new MotorsWithFeedback()
  encoder       = new Encoders()
  line          = new Line()

  // Test: send target spot after calibration
  reaction(send_target) -> controller.target_spot {=
    lf_set(controller.target_spot, 3);  // Change to test different spots
  =}

  // Display: line0 = left trigger count, line1 = current state
  controller.notify -> disp.line0
  controller.state_display -> disp.line1

  // Line Following
  controller.line_enable -> line_follower.enable
  controller.line_enable -> motor_arbiter.use_line_follower
  line.reflect -> line_follower.reflect
  line.reflect -> controller.reflect
  
  // Motor Control
  controller.lp -> motor_arbiter.controller_lp
  controller.rp -> motor_arbiter.controller_rp
  line_follower.lp -> motor_arbiter.line_follower_lp
  line_follower.rp -> motor_arbiter.line_follower_rp
  motor_arbiter.lp -> motors.left_speed
  motor_arbiter.rp -> motors.right_speed

  // Calibration
  controller.calibrate -> line.calibrate

  // Encoders
  encoder.left  -> motors.left
  encoder.right -> motors.right
  
  reaction(t) -> encoder.trigger {=
    lf_set(encoder.trigger, true);
  =}

  reaction(t) -> line.trigger {=
    lf_set(line.trigger, true);
  =}
}
