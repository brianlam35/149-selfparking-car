/**
 * PARKING GARAGE NAVIGATION SYSTEM
 * =================================
 * 
 * Layout:
 *   - Enter: Bottom-left
 *   - Exit: Top-right  
 *   - Spot 1: End of entry path (bottom-right)
 *   - Spots 2-5: First vertical corridor (2,4 on left; 3,5 on right)
 *   - Spots 6-9: Second corridor after 2 left turns (6,8 on right; 7,9 on left)
 * 
 * Counter Logic:
 *   - Starts at -1
 *   - +1 when only one sensor fires (single line)
 *   - +2 when both L and R sensors fire (spots on both sides)
 *   - Non-enterable line: counter becomes 0
 *   - Spot 1: counter = 1
 *   - Spots 2&3: counter = 3
 *   - Spots 4&5: counter = 5
 *   - After 2 left turns for 6-9 area, counter continues from 5
 * 
 * Turn Directions:
 *   - Spots 2-5: Even (2,4) = LEFT, Odd (3,5) = RIGHT
 *   - Spots 6-9: Even (6,8) = RIGHT, Odd (7,9) = LEFT (reversed after 2 lefts)
 */

target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Display from "lib/Display.lf"
import MotorsWithFeedback from "lib/MotorsWithFeedback.lf"
import Encoders from "lib/Encoders.lf"
import Line from "lib/Line.lf"

preamble {=
  #include <math.h>
  #include <stdlib.h>
  #include <pico/stdlib.h>
=}

// ============================================================
// LINE FOLLOWER WITH PID CONTROL
// ============================================================
reactor LineFollower {
  input reflect: uint16_t[5]
  input enable: bool
  
  output lp: float
  output rp: float
  
  // PID parameters - tunable
  state kp: float = 0.15
  state ki: float = 0.0
  state kd: float = 0.05
  
  state base_speed: float = 0.10
  state max_speed: float = 0.15
  state threshold: int = 220
  
  state last_error: float = 0.0
  state integral: float = 0.0
  state enabled: bool = false
  
  reaction(enable) {=
    self->enabled = enable->value;
    // Reset PID state when re-enabled to prevent integral windup
    if (enable->value) {
      self->integral = 0.0f;
      self->last_error = 0.0f;
    }
  =}
  
  reaction(reflect) -> lp, rp {=
    if (!self->enabled) {
      return;  // Let controller handle motors when line follower is disabled
    }
    
    int L0 = reflect->value[0];
    int CL = reflect->value[1];
    int C  = reflect->value[2];
    int CR = reflect->value[3];
    int R4 = reflect->value[4];
    
    // Calculate weighted position error using all 5 sensors
    // Weights: L0=-2, CL=-1, C=0, CR=+1, R4=+2
    float weighted_sum = 0.0f;
    float total_weight = 0.0f;
    
    if (L0 > self->threshold) { weighted_sum += -2.0f * L0; total_weight += L0; }
    if (CL > self->threshold) { weighted_sum += -1.0f * CL; total_weight += CL; }
    if (C  > self->threshold) { weighted_sum +=  0.0f * C;  total_weight += C;  }
    if (CR > self->threshold) { weighted_sum +=  1.0f * CR; total_weight += CR; }
    if (R4 > self->threshold) { weighted_sum +=  2.0f * R4; total_weight += R4; }
    
    if (total_weight < 1.0f) {
      // Lost the line - stop
      lf_set(lp, 0.0f);
      lf_set(rp, 0.0f);
      return;
    }
    
    float error = weighted_sum / total_weight;
    
    // PID calculation with anti-windup
    self->integral += error;
    // Clamp integral to prevent windup
    if (self->integral > 10.0f) self->integral = 10.0f;
    if (self->integral < -10.0f) self->integral = -10.0f;
    
    float derivative = error - self->last_error;
    float correction = self->kp * error + self->ki * self->integral + self->kd * derivative;
    self->last_error = error;
    
    // Apply correction to motor speeds
    float left_speed = self->base_speed + correction;
    float right_speed = self->base_speed - correction;
    
    // Clamp speeds
    if (left_speed > self->max_speed) left_speed = self->max_speed;
    if (left_speed < -self->max_speed) left_speed = -self->max_speed;
    if (right_speed > self->max_speed) right_speed = self->max_speed;
    if (right_speed < -self->max_speed) right_speed = -self->max_speed;
    
    lf_set(lp, left_speed);
    lf_set(rp, right_speed);
  =}
}

// ============================================================
// PARKING GARAGE NAVIGATION CONTROLLER
// ============================================================
reactor ParkingController {
  input reflect: uint16_t[5]
  input target_spot: int
  
  output calibrate: bool
  output line_enable: bool
  output lp: float
  output rp: float
  output notify: string
  output state_display: string  // Shows current state name

  // Tunables
  state threshold: int = 220
  state turn_speed: float = 0.08
  state backup_speed: float = -0.08
  state forward_speed: float = 0.08
  
  // State tracking
  state parking_spot: int = 0
  state counter: int = -1
  state last_left_high: bool = false
  state last_right_high: bool = false
  state turn_committed: bool = false
  state turning: bool = false
  state turns_completed: int = 0
  state exit_turn_direction: int = 0
  state ignore_right_sensor: bool = false  // Ignore right sensor during first turn into corridor
  
  timer end_calibration(5 s)

  // Helper to reset sensor tracking state
  preamble {=
    // No additional includes needed
  =}

  reaction(startup) -> calibrate, line_enable, lp, rp, notify, state_display {=
    lf_set(calibrate, true);
    lf_set(line_enable, false);
    lf_set(lp, 0.0f);
    lf_set(rp, 0.0f);
    lf_set(notify, "CALIBRATING");
    lf_set(state_display, "WAITING");
    printf("=== PARKING GARAGE SYSTEM ===\n");
    printf("Calibrating sensors...\n");
  =}

  reaction(end_calibration) -> calibrate, notify {=
    lf_set(calibrate, false);
    lf_set(notify, "READY");
    printf("System ready - awaiting target\n");
  =}

  // ============================================================
  // MODE: WAITING - Idle, waiting for target parking spot
  // ============================================================
  initial mode WAITING {
    reaction(target_spot) -> reset(NAVIGATE_TO_FIRST_TURN), reset(NAVIGATE_SPOT_1), 
                             line_enable, notify, state_display {=
      self->parking_spot = target_spot->value;
      
      // Reset all state
      self->counter = -1;
      self->last_left_high = false;
      self->last_right_high = false;
      self->turn_committed = false;
      self->turning = false;
      self->turns_completed = 0;
      self->ignore_right_sensor = false;
      
      printf("\n>>> TARGET: Spot %d <<<\n", self->parking_spot);
      
      if (self->parking_spot == 1) {
        // Spot 1: Just go straight, pass the non-enterable line
        lf_set_mode(NAVIGATE_SPOT_1);
        lf_set(line_enable, true);
        lf_set(notify, "NAV->1");
        lf_set(state_display, "NAV_SPOT_1");
      } else if (self->parking_spot >= 2 && self->parking_spot <= 9) {
        // All other spots: First navigate to the first turn
        // Ignore right sensor during first turn to avoid detecting spot 1
        if (self->parking_spot >= 2 && self->parking_spot <= 5) {
          self->ignore_right_sensor = true;
        }
        lf_set_mode(NAVIGATE_TO_FIRST_TURN);
        lf_set(line_enable, true);
        char msg[20];
        snprintf(msg, sizeof(msg), "NAV->%d", self->parking_spot);
        lf_set(notify, msg);
        lf_set(state_display, "NAV_1ST_TRN");
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_SPOT_1 - Go straight to spot 1
  // ============================================================
  mode NAVIGATE_SPOT_1 {
    reaction(reflect) -> notify, state_display, reset(PARK_FORWARD) {=
      int L0 = reflect->value[0];
      
      bool left_high = (L0 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      
      // Detect non-enterable line (left sensor)
      if (left_rising) {
        self->counter = 0;
        lf_set(notify, "PASS INT");
        printf("Passed non-enterable intersection\n");
      }
      self->last_left_high = left_high;

      // After passing intersection, just keep going until line ends
      if (self->counter >= 0 && !self->turn_committed) {
        self->turn_committed = true;
        lf_set_mode(PARK_FORWARD);
        lf_set(notify, "TO SPOT 1");
        lf_set(state_display, "PARK_FWD");
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_TO_FIRST_TURN - Get to first intersection and turn left
  // ============================================================
  mode NAVIGATE_TO_FIRST_TURN {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_CORRIDOR), reset(NAVIGATE_SPOT_1) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      
      // Only count when NOT turning
      if (!self->turning) {
        if (left_rising) {
          self->counter++;
          char msg[20];
          snprintf(msg, sizeof(msg), "CNT:%d", self->counter);
          lf_set(notify, msg);
          printf("Counter: %d\n", self->counter);
          
          // When we hit counter=0 (non-enterable line), start turning left
          if (self->counter == 0) {
            self->turning = true;
            lf_set(line_enable, false);
            lf_set_mode(TURN_INTO_CORRIDOR);
            lf_set(notify, "TURN LEFT");
            lf_set(state_display, "TURN_CORR");
            printf("Starting left turn into corridor\n");
          }
        }
        self->last_left_high = left_high;
      }
    =}
  }

  // ============================================================
  // MODE: TURN_INTO_CORRIDOR - Dedicated state to complete left turn
  // Ignores ALL sensor inputs for counting until turn is complete
  // ============================================================
  mode TURN_INTO_CORRIDOR {
    reaction(reflect) -> lp, rp, line_enable, notify, state_display,
                         reset(NAVIGATE_CORRIDOR_2_5), reset(NAVIGATE_CORRIDOR_6_9) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      
      bool left_high = (L0 > self->threshold);
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      
      // Execute left turn - IGNORE everything else
      lf_set(lp, -self->turn_speed);
      lf_set(rp, self->turn_speed);
      
      // Turn complete ONLY when:
      // 1. Center sensors see the line (we're aligned with corridor)
      // 2. Left sensor is OFF (we've rotated past the intersection)
      if (center_line && !left_high) {
        // Reset ALL sensor states
        self->last_left_high = false;
        self->last_right_high = false;
        self->turning = false;
        self->turn_committed = false;
        
        lf_set(line_enable, true);
        
        if (self->parking_spot >= 6 && self->parking_spot <= 9) {
          self->ignore_right_sensor = false;
          lf_set_mode(NAVIGATE_CORRIDOR_6_9);
          lf_set(notify, "CORR 6-9");
          lf_set(state_display, "NAV_6-9");
          printf("Turn complete - entering corridor for spots 6-9\n");
        } else {
          // Keep ignoring right sensor until we pass spot 1
          lf_set_mode(NAVIGATE_CORRIDOR_2_5);
          lf_set(notify, "CORR 2-5");
          lf_set(state_display, "NAV_2-5");
          printf("Turn complete - entering corridor for spot %d (right sensor still ignored)\n", self->parking_spot);
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_CORRIDOR_2_5 - Navigate corridor to spots 2-5
  // Counter after entering corridor: 0
  // Pass spot 1 (left only): counter = 1 -> RE-ENABLE right sensor AFTER leaving this intersection
  // Pass spots 2&3 (both): counter = 3  
  // Pass spots 4&5 (both): counter = 5
  // ============================================================
  mode NAVIGATE_CORRIDOR_2_5 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_SPOT) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      
      // Read actual right sensor value
      bool right_high_actual = (R4 > self->threshold);
      
      // If ignoring right sensor, treat it as not detecting anything
      bool right_high = self->ignore_right_sensor ? false : right_high_actual;
      
      bool left_rising = (left_high && !self->last_left_high);
      bool left_falling = (!left_high && self->last_left_high);
      
      // Only use right_rising if we're not ignoring it
      bool right_rising = (!self->ignore_right_sensor && right_high && !self->last_right_high);

      // Count intersections (only when not turning)
      if (!self->turning && left_rising) {
        // Only count on left rising edge while ignoring right sensor
        // This ensures we count spot 1 correctly
        if (self->ignore_right_sensor) {
          self->counter += 1;
        } else if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "CNT:%d->%d", self->counter, self->parking_spot);
        lf_set(notify, msg);
        printf("Corridor count: %d, target: %d\n", self->counter, self->parking_spot);
      }
      
      // RE-ENABLE right sensor only AFTER we've LEFT spot 1's intersection
      // (when left sensor goes from HIGH to LOW after counter reached 1)
      if (self->ignore_right_sensor && self->counter >= 1 && left_falling) {
        self->ignore_right_sensor = false;
        lf_set(notify, "R SNS ON");
        printf("Right sensor NOW ENABLED - left spot 1 intersection\n");
      }
      
      // Update last states (use actual right sensor value for tracking)
      self->last_left_high = left_high;
      self->last_right_high = right_high_actual;

      // Determine when to turn based on target spot
      // Spot 2: turn LEFT when counter >= 1 and left sensor high
      // Spot 3: turn RIGHT when counter >= 1 and right sensor high  
      // Spot 4: turn LEFT when counter >= 3 and left sensor high
      // Spot 5: turn RIGHT when counter >= 3 and right sensor high
      
      int turn_threshold;
      if (self->parking_spot == 2 || self->parking_spot == 3) {
        turn_threshold = 1;
      } else {
        turn_threshold = 3;
      }
      
      // Don't allow turning if we're still ignoring the right sensor (haven't passed spot 1 yet)
      if (self->counter >= turn_threshold && !self->turn_committed && !self->ignore_right_sensor) {
        bool should_turn = false;
        
        if (self->parking_spot % 2 == 0) {
          // Even spots (2, 4): turn left
          should_turn = left_high;
        } else {
          // Odd spots (3, 5): turn right
          should_turn = right_high;
        }
        
        if (should_turn) {
          self->turn_committed = true;
          self->turning = true;
          lf_set(line_enable, false);
          lf_set_mode(TURN_INTO_SPOT);
          lf_set(notify, "TURN IN");
          lf_set(state_display, "TURN_IN");
          printf("Turning into spot %d\n", self->parking_spot);
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_CORRIDOR_6_9 - Pass all spots, then make 2 left turns
  // ============================================================
  mode NAVIGATE_CORRIDOR_6_9 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(MAKE_TWO_LEFT_TURNS) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);

      // Count all intersections until we pass spot 5
      if (!self->turning && (left_rising || right_rising)) {
        if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "CNT:%d", self->counter);
        lf_set(notify, msg);
        printf("Corridor count: %d\n", self->counter);
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high;

      // After passing spot 5 (counter >= 5), transition to make 2 left turns
      if (self->counter >= 5 && !self->turn_committed) {
        self->turn_committed = true;
        self->turns_completed = 0;
        lf_set_mode(MAKE_TWO_LEFT_TURNS);
        lf_set(notify, "2 TURNS");
        lf_set(state_display, "2_L_TURNS");
        printf("Starting 2 left turns for spots 6-9\n");
      }
    =}
  }

  // ============================================================
  // MODE: MAKE_TWO_LEFT_TURNS - Execute 2 left turns to reach 6-9 area
  // ============================================================
  mode MAKE_TWO_LEFT_TURNS {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(NAVIGATE_FINAL_6_9) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];

      bool left_high = (L0 > self->threshold);
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      
      if (self->turns_completed < 2) {
        if (left_high) {
          // Detected intersection, execute turn
          self->turning = true;
          lf_set(line_enable, false);
          lf_set(lp, -self->turn_speed);
          lf_set(rp, self->turn_speed);
          
          char msg[20];
          snprintf(msg, sizeof(msg), "TURN %d/2", self->turns_completed + 1);
          lf_set(notify, msg);
        }
        
        // Check if turn complete
        if (self->turning && !left_high && center_line) {
          self->turns_completed++;
          self->turning = false;
          lf_set(line_enable, true);
          
          char msg[20];
          snprintf(msg, sizeof(msg), "DONE %d/2", self->turns_completed);
          lf_set(notify, msg);
          printf("Completed turn %d/2\n", self->turns_completed);
          
          if (self->turns_completed >= 2) {
            // Reset for final navigation
            self->turn_committed = false;
            self->last_left_high = false;
            self->last_right_high = false;
            // Counter stays at 5 - will count up from here
            lf_set_mode(NAVIGATE_FINAL_6_9);
            lf_set(notify, "FINAL 6-9");
            lf_set(state_display, "NAV_FNL69");
            printf("Entering final corridor for spots 6-9\n");
          }
        }
      }
    =}
  }

  // ============================================================
  // MODE: NAVIGATE_FINAL_6_9 - Navigate to final spot 6-9
  // After 2 left turns: Even (6,8) on RIGHT, Odd (7,9) on LEFT
  // ============================================================
  mode NAVIGATE_FINAL_6_9 {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(TURN_INTO_SPOT) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);

      // Count intersections
      if (!self->turning && (left_rising || right_rising)) {
        if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "CNT:%d->%d", self->counter, self->parking_spot);
        lf_set(notify, msg);
        printf("Final corridor count: %d, target: %d\n", self->counter, self->parking_spot);
      }
      
      self->last_left_high = left_high;
      self->last_right_high = right_high;

      // Turn thresholds for spots 6-9:
      // Spot 6,7: turn when counter >= 5 (first intersection after turns)
      // Spot 8,9: turn when counter >= 7
      int turn_threshold;
      if (self->parking_spot == 6 || self->parking_spot == 7) {
        turn_threshold = 5;
      } else {
        turn_threshold = 7;
      }
      
      if (self->counter >= turn_threshold && !self->turn_committed) {
        bool should_turn = false;
        
        // REVERSED from 2-5: Even (6,8) = RIGHT, Odd (7,9) = LEFT
        if (self->parking_spot % 2 == 0) {
          should_turn = right_high;  // 6, 8 turn right
        } else {
          should_turn = left_high;   // 7, 9 turn left
        }
        
        if (should_turn) {
          self->turn_committed = true;
          self->turning = true;
          lf_set(line_enable, false);
          lf_set_mode(TURN_INTO_SPOT);
          lf_set(notify, "TURN IN");
          lf_set(state_display, "TURN_IN");
          printf("Turning into spot %d\n", self->parking_spot);
        }
      }
    =}
  }

  // ============================================================
  // MODE: TURN_INTO_SPOT - Turn into parking spot
  // ============================================================
  mode TURN_INTO_SPOT {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(PARK_FORWARD) {=
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);

      // Determine turn direction
      bool turn_right;
      if (self->parking_spot >= 6) {
        // Spots 6-9: Even = RIGHT, Odd = LEFT
        turn_right = (self->parking_spot % 2 == 0);
      } else {
        // Spots 2-5: Even = LEFT, Odd = RIGHT
        turn_right = (self->parking_spot % 2 == 1);
      }

      // Execute turn
      if (turn_right) {
        lf_set(lp, self->turn_speed);
        lf_set(rp, -self->turn_speed);
      } else {
        lf_set(lp, -self->turn_speed);
        lf_set(rp, self->turn_speed);
      }

      // Turn complete when center sensors see the parking spot line
      // and we've rotated away from the main corridor
      bool rotated_away = turn_right ? !right_high : !left_high;
      
      if (center_line && rotated_away) {
        self->turning = false;
        lf_set(line_enable, true);
        lf_set_mode(PARK_FORWARD);
        lf_set(notify, "PARKING");
        lf_set(state_display, "PARK_FWD");
        printf("Aligned with spot %d, parking...\n", self->parking_spot);
      }
    =}
  }

  // ============================================================
  // MODE: PARK_FORWARD - Follow line into spot until it ends
  // ============================================================
  mode PARK_FORWARD {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(PARKED) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool all_white = (L0 < self->threshold && CL < self->threshold && 
                       C < self->threshold && CR < self->threshold && R4 < self->threshold);

      if (all_white) {
        lf_set(line_enable, false);
        lf_set(lp, 0.0f);
        lf_set(rp, 0.0f);
        lf_set_mode(PARKED);
        lf_set(notify, "PARKED!");
        lf_set(state_display, "PARKED");
        printf("=== PARKED IN SPOT %d ===\n", self->parking_spot);
      }
      // Line follower handles forward motion when enabled
    =}
  }

  // ============================================================
  // MODE: PARKED - Wait for exit command (target_spot = 0)
  // ============================================================
  mode PARKED {
    reaction(target_spot) -> reset(EXIT_BACKUP), line_enable, notify, state_display {=
      if (target_spot->value == 0) {
        // Reset state for exit
        self->turn_committed = false;
        self->turning = false;
        self->turns_completed = 0;
        self->last_left_high = false;
        self->last_right_high = false;
        
        lf_set(line_enable, false);
        lf_set_mode(EXIT_BACKUP);
        lf_set(notify, "EXITING");
        lf_set(state_display, "EXIT_BACK");
        printf("\n>>> EXITING SPOT %d <<<\n", self->parking_spot);
      }
    =}
  }

  // ============================================================
  // MODE: EXIT_BACKUP - Back out of parking spot
  // ============================================================
  mode EXIT_BACKUP {
    reaction(reflect) -> lp, rp, notify, state_display, reset(EXIT_TURN_90) {=
      int L0 = reflect->value[0];
      int R4 = reflect->value[4];

      // Back up
      lf_set(lp, self->backup_speed);
      lf_set(rp, self->backup_speed);

      bool detect_main_path = false;
      
      // Determine which sensor detects main path based on spot
      if (self->parking_spot == 1) {
        // Spot 1: main path on left
        detect_main_path = (L0 > self->threshold);
        self->exit_turn_direction = 1;  // turn left
      } else if (self->parking_spot >= 2 && self->parking_spot <= 5) {
        if (self->parking_spot % 2 == 0) {
          // Even spots (2, 4): came from left, main path on right
          detect_main_path = (R4 > self->threshold);
          self->exit_turn_direction = -1;  // turn right
        } else {
          // Odd spots (3, 5): came from right, main path on left
          detect_main_path = (L0 > self->threshold);
          self->exit_turn_direction = 1;  // turn left
        }
      } else if (self->parking_spot >= 6 && self->parking_spot <= 9) {
        if (self->parking_spot % 2 == 0) {
          // Even spots (6, 8): came from right, main path on left
          detect_main_path = (L0 > self->threshold);
          self->exit_turn_direction = 1;  // turn left
        } else {
          // Odd spots (7, 9): came from left, main path on right
          detect_main_path = (R4 > self->threshold);
          self->exit_turn_direction = -1;  // turn right
        }
        // Set counter for exit navigation
        self->counter = (self->parking_spot % 2 == 0) ? self->parking_spot + 1 : self->parking_spot;
      }

      if (detect_main_path) {
        lf_set_mode(EXIT_TURN_90);
        lf_set(notify, "TURN 90");
        lf_set(state_display, "EXIT_TRN");
        printf("Detected main path, turning...\n");
      }
    =}
  }

  // ============================================================
  // MODE: EXIT_TURN_90 - Turn onto main path
  // ============================================================
  mode EXIT_TURN_90 {
    reaction(reflect) -> lp, rp, line_enable, notify, state_display,
                         reset(EXIT_NAVIGATE), reset(EXIT_6_9_NAVIGATE) {=
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];

      // Execute turn
      if (self->exit_turn_direction == 1) {
        lf_set(lp, -self->turn_speed);
        lf_set(rp, self->turn_speed);
      } else {
        lf_set(lp, self->turn_speed);
        lf_set(rp, -self->turn_speed);
      }

      // Turn complete when center sensors detect line
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);
      
      if (center_line) {
        self->last_left_high = false;
        self->last_right_high = false;
        lf_set(line_enable, true);
        
        if (self->parking_spot >= 6 && self->parking_spot <= 9) {
          self->turns_completed = 0;
          lf_set_mode(EXIT_6_9_NAVIGATE);
          lf_set(notify, "EXIT 6-9");
          lf_set(state_display, "EX_NAV69");
          printf("Exiting from spot 6-9, navigating back...\n");
        } else {
          lf_set_mode(EXIT_NAVIGATE);
          lf_set(notify, "TO EXIT");
          lf_set(state_display, "EXIT_NAV");
          printf("Heading to exit...\n");
        }
      }
    =}
  }

  // ============================================================
  // MODE: EXIT_6_9_NAVIGATE - Navigate from 6-9 back through garage
  // Need to pass remaining spots, make 2 left turns, then exit
  // ============================================================
  mode EXIT_6_9_NAVIGATE {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(EXIT_NAVIGATE) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool left_high = (L0 > self->threshold);
      bool right_high = (R4 > self->threshold);
      bool left_rising = (left_high && !self->last_left_high);
      bool right_rising = (right_high && !self->last_right_high);
      bool center_line = (CL > self->threshold || C > self->threshold || CR > self->threshold);

      // Count spots as we pass them (only when not turning)
      if (!self->turning && (left_rising || right_rising)) {
        if (left_high && right_high) {
          self->counter += 2;
        } else {
          self->counter += 1;
        }
        
        char msg[20];
        snprintf(msg, sizeof(msg), "EX CNT:%d", self->counter);
        lf_set(notify, msg);
        printf("Exit counter: %d\n", self->counter);
      }
      
      if (!self->turning) {
        self->last_left_high = left_high;
        self->last_right_high = right_high;
      }

      // After counter >= 9, make 2 left turns at intersections
      if (self->counter >= 9 && self->turns_completed < 2) {
        if (left_high && !self->turning) {
          self->turning = true;
          lf_set(line_enable, false);
          lf_set(lp, -self->turn_speed);
          lf_set(rp, self->turn_speed);
          
          char msg[20];
          snprintf(msg, sizeof(msg), "EX TRN %d", self->turns_completed + 1);
          lf_set(notify, msg);
          lf_set(state_display, "EX_TURN");
        }
        
        if (self->turning) {
          lf_set(lp, -self->turn_speed);
          lf_set(rp, self->turn_speed);
          
          if (!left_high && center_line) {
            self->turns_completed++;
            self->turning = false;
            lf_set(line_enable, true);
            printf("Exit turn %d complete\n", self->turns_completed);
            
            if (self->turns_completed >= 2) {
              lf_set_mode(EXIT_NAVIGATE);
              lf_set(notify, "TO EXIT");
              lf_set(state_display, "EXIT_NAV");
              printf("Heading to exit...\n");
            }
          }
        }
      }
    =}
  }

  // ============================================================
  // MODE: EXIT_NAVIGATE - Follow line to exit
  // ============================================================
  mode EXIT_NAVIGATE {
    reaction(reflect) -> line_enable, lp, rp, notify, state_display, reset(WAITING) {=
      int L0 = reflect->value[0];
      int CL = reflect->value[1];
      int C  = reflect->value[2];
      int CR = reflect->value[3];
      int R4 = reflect->value[4];

      bool all_white = (L0 < self->threshold && CL < self->threshold && 
                       C < self->threshold && CR < self->threshold && R4 < self->threshold);

      if (all_white) {
        lf_set(line_enable, false);
        lf_set(lp, 0.0f);
        lf_set(rp, 0.0f);
        lf_set_mode(WAITING);
        lf_set(notify, "EXITED!");
        lf_set(state_display, "WAITING");
        printf("=== SUCCESSFULLY EXITED ===\n\n");
      }
      // Line follower handles forward motion
    =}
  }
}

// ============================================================
// MOTOR ARBITER - Selects between controller and line follower
// ============================================================
reactor MotorArbiter {
  input controller_lp: float
  input controller_rp: float
  input line_follower_lp: float
  input line_follower_rp: float
  input use_line_follower: bool
  
  output lp: float
  output rp: float
  
  state use_follower: bool = false
  
  reaction(use_line_follower) {=
    self->use_follower = use_line_follower->value;
  =}
  
  reaction(controller_lp, controller_rp) -> lp, rp {=
    if (!self->use_follower) {
      if (controller_lp->is_present) lf_set(lp, controller_lp->value);
      if (controller_rp->is_present) lf_set(rp, controller_rp->value);
    }
  =}
  
  reaction(line_follower_lp, line_follower_rp) -> lp, rp {=
    if (self->use_follower) {
      if (line_follower_lp->is_present) lf_set(lp, line_follower_lp->value);
      if (line_follower_rp->is_present) lf_set(rp, line_follower_rp->value);
    }
  =}
}

// ============================================================
// MAIN REACTOR
// ============================================================
main reactor {
  timer t(0, 10 ms)
  timer send_target(6 s)  // Test: send target after 6 seconds

  controller    = new ParkingController()
  line_follower = new LineFollower()
  motor_arbiter = new MotorArbiter()
  disp          = new Display()
  motors        = new MotorsWithFeedback()
  encoder       = new Encoders()
  line          = new Line()

  // === TEST: Send target spot after calibration ===
  reaction(send_target) -> controller.target_spot {=
    lf_set(controller.target_spot, 3);  // Change this to test different spots
  =}

  // === Display ===
  controller.notify -> disp.line0
  controller.state_display -> disp.line1

  // === Line Following ===
  controller.line_enable -> line_follower.enable
  controller.line_enable -> motor_arbiter.use_line_follower
  line.reflect -> line_follower.reflect
  line.reflect -> controller.reflect
  
  // === Motor Control ===
  controller.lp -> motor_arbiter.controller_lp
  controller.rp -> motor_arbiter.controller_rp
  line_follower.lp -> motor_arbiter.line_follower_lp
  line_follower.rp -> motor_arbiter.line_follower_rp
  motor_arbiter.lp -> motors.left_speed
  motor_arbiter.rp -> motors.right_speed

  // === Calibration ===
  controller.calibrate -> line.calibrate

  // === Encoders ===
  encoder.left  -> motors.left
  encoder.right -> motors.right
  
  reaction(t) -> encoder.trigger {=
    lf_set(encoder.trigger, true);
  =}

  reaction(t) -> line.trigger {=
    lf_set(line.trigger, true);
  =}
}
